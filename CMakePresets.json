{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "vcpkg-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },

        {
            "name": "debug-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "-O0 -g -ggdb3 -march=native",
                "CMAKE_C_FLAGS": "-O0 -g -ggdb3 -march=native"
            }
        },
        {
            "name": "release-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS": "-O3 -march=native",
                "CMAKE_C_FLAGS": "-O3 -march=native"
            }
        },
        {
            "name": "ci-gcc-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "DISABLE_RECOMMENDED_COMPILER": "ON",
                "CMAKE_CXX_FLAGS": "-O0 -g",
                "CMAKE_C_FLAGS": "-O0 -g"
            }
        },
        {
            "name": "ci-clang-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "DISABLE_RECOMMENDED_COMPILER": "ON",
                "CMAKE_CXX_FLAGS": "-O0 -g",
                "CMAKE_C_FLAGS": "-O0 -g"
            }
        },
        {
            "name": "release-gcc-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "DISABLE_RECOMMENDED_COMPILER": "ON",
                "CMAKE_CXX_FLAGS": "-O3",
                "CMAKE_C_FLAGS": "-O3"
            }
        },
        {
            "name": "release-clang-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "DISABLE_RECOMMENDED_COMPILER": "ON",
                "CMAKE_CXX_FLAGS": "-O3",
                "CMAKE_C_FLAGS": "-O3"
            }
        },
        {
            "name": "ci-msvc-base",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DISABLE_RECOMMENDED_COMPILER": "ON",
                "ENABLE_CUSTOM_ALLOCATOR": "OFF"
            }
        },
        {
            "name": "debug-gcc-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "DISABLE_RECOMMENDED_COMPILER": "ON",
                "CMAKE_CXX_FLAGS": "-O0 -g",
                "CMAKE_C_FLAGS": "-O0 -g"
            }
        },
        {
            "name": "debug-clang-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "DISABLE_RECOMMENDED_COMPILER": "ON",
                "CMAKE_CXX_FLAGS": "-O0 -g",
                "CMAKE_C_FLAGS": "-O0 -g"
            }
        },
        {
            "name": "debug-msvc-base",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DISABLE_RECOMMENDED_COMPILER": "ON",
                "ENABLE_CUSTOM_ALLOCATOR": "OFF"
            }
        },
        {
            "name": "release-msvc-base",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "DISABLE_RECOMMENDED_COMPILER": "ON",
                "ENABLE_CUSTOM_ALLOCATOR": "OFF"
            }
        },
        {
            "name": "docs-base",
            "hidden": true,
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/docs",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "OFF",
                "ENABLE_CLANG_TIDY": "OFF"
            }
        },



        {
            "name": "debug",
            "displayName": "Debug (No Sanitizers)",
            "inherits": "debug-base"
        },
        {
            "name": "debug-asan",
            "displayName": "Debug (Address Sanitizer)",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -O0 -g -ggdb3 -march=native",
                "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g -O0 -ggdb3 -march=native",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address"
            }
        },
        {
            "name": "debug-ubsan",
            "displayName": "Debug (Undefined Behavior Sanitizer)",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer -O0 -g -ggdb3 -march=native",
                "CMAKE_C_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer -g -O0 -ggdb3 -march=native",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=undefined"
            }
        },
        {
            "name": "debug-tsan",
            "displayName": "Debug (Thread Sanitizer)",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -O0 -g -ggdb3 -march=native",
                "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g -O0 -ggdb3 -march=native",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
            }
        },
        {
            "name": "debug-msan",
            "displayName": "Debug (Memory Sanitizer)",
            "inherits": "debug-base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=memory -fno-omit-frame-pointer -O0 -g -ggdb3 -march=native",
                "CMAKE_C_FLAGS": "-fsanitize=memory -fno-omit-frame-pointer -g -O0 -ggdb3 -march=native",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=memory",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=memory"
            }
        },



        {
            "name": "release",
            "displayName": "Release (No Linker Optimizations)",
            "inherits": "release-base"
        },
        {
            "name": "release-lto",
            "displayName": "Release (LTO)",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-flto -O3 -march=native",
                "CMAKE_C_FLAGS": "-flto -O3 -march=native",
                "CMAKE_EXE_LINKER_FLAGS": "-flto",
                "CMAKE_SHARED_LINKER_FLAGS": "-flto"
            }
        },
        {
            "name": "release-thinlto",
            "displayName": "Release (ThinLTO)",
            "inherits": "release-base",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-flto=thin -O3 -march=native",
                "CMAKE_C_FLAGS": "-flto=thin -O3 -march=native",
                "CMAKE_EXE_LINKER_FLAGS": "-flto=thin",
                "CMAKE_SHARED_LINKER_FLAGS": "-flto=thin"
            }
        },
        {
            "name": "debug-vcpkg",
            "displayName": "Debug (vcpkg)",
            "inherits": ["debug-base", "vcpkg-base"]
        },
        {
            "name": "debug-gcc",
            "displayName": "Debug (GCC)",
            "inherits": "debug-gcc-base"
        },
        {
            "name": "debug-clang",
            "displayName": "Debug (Clang)",
            "inherits": "debug-clang-base"
        },
        {
            "name": "debug-msvc",
            "displayName": "Debug (MSVC)",
            "inherits": "debug-msvc-base"
        },
        {
            "name": "debug-asan-vcpkg",
            "displayName": "Debug (Address Sanitizer, vcpkg)",
            "inherits": ["debug-asan", "vcpkg-base"]
        },
        {
            "name": "release-vcpkg",
            "displayName": "Release (vcpkg)",
            "inherits": ["release-base", "vcpkg-base"]
        },
        {
            "name": "release-gcc",
            "displayName": "Release (GCC)",
            "inherits": "release-gcc-base"
        },
        {
            "name": "release-clang",
            "displayName": "Release (Clang)",
            "inherits": "release-clang-base"
        },
        {
            "name": "docs",
            "displayName": "Documentation",
            "inherits": "docs-base"
        },
        {
            "name": "docs-vcpkg",
            "displayName": "Documentation (vcpkg)",
            "inherits": ["docs-base", "vcpkg-base"]
        },
        {
            "name": "ci-gcc",
            "displayName": "CI Debug (GCC)",
            "inherits": "ci-gcc-base"
        },
        {
            "name": "ci-clang",
            "displayName": "CI Debug (Clang)",
            "inherits": "ci-clang-base"
        },
        {
            "name": "ci-msvc",
            "displayName": "CI Debug (MSVC)",
            "inherits": "ci-msvc-base"
        },
        {
            "name": "release-msvc",
            "displayName": "Release (MSVC)",
            "inherits": "release-msvc-base"
        }
    ],

    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "debug-asan",
            "configurePreset": "debug-asan"
        },
        {
            "name": "debug-ubsan",
            "configurePreset": "debug-ubsan"
        },
        {
            "name": "debug-tsan",
            "configurePreset": "debug-tsan"
        },
        {
            "name": "debug-msan",
            "configurePreset": "debug-msan"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "release-lto",
            "configurePreset": "release-lto"
        },
        {
            "name": "release-thinlto",
            "configurePreset": "release-thinlto"
        },
        {
            "name": "debug-vcpkg",
            "configurePreset": "debug-vcpkg"
        },
        {
            "name": "debug-gcc",
            "configurePreset": "debug-gcc"
        },
        {
            "name": "debug-clang",
            "configurePreset": "debug-clang"
        },
        {
            "name": "debug-msvc",
            "configurePreset": "debug-msvc"
        },
        {
            "name": "debug-asan-vcpkg",
            "configurePreset": "debug-asan-vcpkg"
        },
        {
            "name": "release-vcpkg",
            "configurePreset": "release-vcpkg"
        },
        {
            "name": "release-gcc",
            "configurePreset": "release-gcc"
        },
        {
            "name": "release-clang",
            "configurePreset": "release-clang"
        },
        {
            "name": "docs",
            "configurePreset": "docs"
        },
        {
            "name": "docs-vcpkg",
            "configurePreset": "docs-vcpkg"
        },
        {
            "name": "ci-gcc",
            "configurePreset": "ci-gcc"
        },
        {
            "name": "ci-clang",
            "configurePreset": "ci-clang"
        },
        {
            "name": "ci-msvc",
            "configurePreset": "ci-msvc"
        },
        {
            "name": "release-msvc",
            "configurePreset": "release-msvc"
        }
    ]
}
